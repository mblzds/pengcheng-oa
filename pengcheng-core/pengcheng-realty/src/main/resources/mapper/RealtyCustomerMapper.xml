<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pengcheng.realty.customer.mapper.RealtyCustomerMapper">

    <select id="selectPageWithScope" resultType="com.pengcheng.realty.customer.entity.Customer">
        SELECT * FROM customer
        WHERE deleted = 0
        <if test="ew != null and ew.nonEmptyOfWhere">
            AND ${ew.sqlSegment}
        </if>
        <if test="ew != null and !ew.nonEmptyOfWhere and ew.sqlSegment != null and ew.sqlSegment != ''">
            ${ew.sqlSegment}
        </if>
    </select>

    <select id="selectListWithScope" resultType="com.pengcheng.realty.customer.entity.Customer">
        SELECT * FROM customer
        WHERE deleted = 0
        <if test="ew != null and ew.nonEmptyOfWhere">
            AND ${ew.sqlSegment}
        </if>
        <if test="ew != null and !ew.nonEmptyOfWhere and ew.sqlSegment != null and ew.sqlSegment != ''">
            ${ew.sqlSegment}
        </if>
    </select>

</mapper>
